{
  "name": "slack-my-assistant",
  "version": "1.0.0",
  "description": "A Slack bot that connects to the Claude Code CLI with persistent session management",
  "license": "MIT",
  "keywords": [
    "slack",
    "claude",
    "claude-code",
    "chatbot",
    "ai",
    "automation"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "yarn build",
    "build": "yarn build:clean && tsc",
    "build:clean": "shx rm -rf ./dist",
    "start": "node --env-file=.env dist/index.js",
    "dev": "node --env-file=.env --import=tsx src/index.ts"
  },
  "dependencies": {
    "@slack/bolt": "^4.6.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
