# Slack App Configuration
# Get these from https://api.slack.com/apps
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_APP_TOKEN=xapp-your_app_level_token
SLACK_TOKEN=xoxb-your_bot_token

# Access Control
# Comma-separated Slack user IDs allowed to use the bot
ALLOWED_USERS=U00000001,U00000002

# Project Directories
# Comma-separated absolute paths to directories Claude Code can access
PROJECT_DIRS=/path/to/project1,/path/to/project2

# Optional: Server port (default: 3000)
# PORT=3000

# Optional: Skip Claude Code permission prompts (default: true)
# Set to "false" to require manual permission approval
# SKIP_PERMISSIONS=true

# Optional: Output and temp directories
# OUTPUT_DIR=./output
# TEMP_DIR=./temp
# DB_PATH=./data/sessions.db

# MCP Configuration (optional)
# Path to MCP server configuration file (see mcp-config.example.json)
# MCP_CONFIG_PATH=./mcp-config.json

# Datadog (required if using Datadog MCP server)
# DATADOG_API_KEY=your_datadog_api_key
# DATADOG_APP_KEY=your_datadog_app_key
# DATADOG_SITE=datadoghq.com
